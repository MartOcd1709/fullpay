# --- Database (Render internal URL has no sslmode; an external URL needs ?sslmode=require) ---
DATABASE_URL=postgres://fullpay:password@localhost:5432/fullpay

# --- Owner login (single-tenant demo) ---
OWNER_PASSWORD=change-me
SESSION_SECRET=replace-with-32-random-bytes-hex

# --- Scheduler and demo controls ---
TICK_SECRET=replace-with-32-random-bytes-hex      # shared with the Render Workflow and cron-job.org
RESEED_SECRET=replace-with-32-random-bytes-hex    # nightly reseed (cron-job.org) and /api/reseed
DEMO_MODE=1                                       # enables the demo clock (/api/demo/*)
SCHEDULER=on                                      # built-in 10:00 IST daily run + nightly demo reset; off = only /api/tick

# --- Email (Resend). A verified domain is required: resend.dev only delivers to your own inbox ---
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM="FullPay for Arora Auto Components <billing@example.in>"
MAIL_REPLY_TO=owner@example.in
MAIL_TEST_MODE=1                                  # 1 = every email goes to MAIL_TEST_TO instead of the customer
MAIL_TEST_TO=owner@example.in

# --- Public URL used in emails, pay links and QR codes ---
APP_URL=http://localhost:3000

# --- Optional integrations ---
N8N_WEBHOOK_URL=
LLM_API_KEY=                                      # tone drafting only; never in the money path

# --- Render (used by the cron job to start the Workflow task) ---
RENDER_API_KEY=
